# Copy to .env (python -m money init does this). .env is gitignored - never commit it.
# Keys: https://dashboard.plaid.com/developers/keys

PLAID_CLIENT_ID=
# Use the secret that matches PLAID_ENV (Plaid issues separate sandbox and production secrets).
PLAID_SECRET=
# production = your real accounts (free Trial plan: up to 10 connections)
# sandbox    = fake test bank (log in with user_good / pass_good)
PLAID_ENV=production

# Dashboard port (http://127.0.0.1:8765)
MONEY_PORT=8765
