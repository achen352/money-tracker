#!/bin/sh
# Refuse to commit secrets or financial data to this (public) repo.
# Enabled by `python -m money init` (git config core.hooksPath .githooks).

blocked=$(git diff --cached --name-only --diff-filter=ACMR \
  | grep -E '(^|/)\.env($|\.)|^secrets/|^data/|\.db$|\.db-|\.sqlite|(^|/)CLAUDE\.local\.md$|plaid_items\.json' \
  | grep -v '\.env\.example$')
if [ -n "$blocked" ]; then
  echo "pre-commit: refusing to commit private files:" >&2
  echo "$blocked" >&2
  exit 1
fi

if git diff --cached -U0 | grep -E '^\+' | grep -Eq 'access-(sandbox|production|development)-[0-9a-f-]{20,}'; then
  echo "pre-commit: staged changes contain what looks like a Plaid access token." >&2
  exit 1
fi

if git diff --cached -U0 | grep -E '^\+' | grep -Eq 'PLAID_SECRET *= *[A-Za-z0-9]{12,}'; then
  echo "pre-commit: staged changes contain what looks like a Plaid secret." >&2
  exit 1
fi
exit 0
